APP_ENV=local
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Infrastructure
DATABASE_URL=mysql+asyncmy://sales:sales@localhost:3306/sales_assistant
REDIS_URL=redis://localhost:6380/0
MILVUS_URI=http://localhost:19530
KAFKA_BOOTSTRAP=localhost:9092
OBJECT_STORE_ENDPOINT=http://localhost:9000

# Auth (local can be disabled; production must be oidc)
AUTH_MODE=disabled
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_TENANT_CLAIM=tenant_id
OIDC_USER_ID_CLAIM=user_id

# Model gateway (local connects directly to external OpenAI-compatible gateways)
# Set to openai_compatible once you fill in the API keys below.
MODEL_PROVIDER=mock

# LLM gateway: Aliyun DashScope (OpenAI-compatible)
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
# Options: qwen3.7-max / qwen3.7-max-2026-05-20 /
#          qwen3.5-livetranslate-flash-realtime-2026-05-19 /
#          qwen3.5-livetranslate-flash-realtime
MODEL_NAME_ROUTER=qwen-turbo
MODEL_NAME_SYNTH=qwen-max

# Embedding / Rerank gateway: Aliyun DashScope (native API)
EMBEDDING_PROVIDER=dashscope
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com
EMBEDDING_API_KEY=
EMBEDDING_MODEL=tongyi-embedding-vision-flash
RERANK_MODEL=qwen3-vl-rerank
MODEL_TIMEOUT_SECONDS=20

# Retrieval params
RRF_K=60
RRF_WEIGHT_DENSE=1.0
RRF_WEIGHT_BM25=1.0
RETRIEVAL_TOP_K=50
RERANK_INPUT=40
FINAL_EVIDENCE=8

# Budgets
MAX_MODEL_CALLS=8
MAX_PLANNER_TASKS=4
MAX_REFLECTIONS=1
WALL_CLOCK_SECONDS=25

# Feature flags
FEATURE_HYDE=true
FEATURE_REFLECTION=true
FEATURE_KNOWLEDGE_LOOP=true

# Runtime
REQUEST_TIMEOUT_SECONDS=30
CONVERSATION_LEASE_SECONDS=45
SSE_RETENTION_SECONDS=600

# Short-term memory (sliding window + rolling summary; memory-design.md 3)
STM_RECENT_TURNS=8
STM_SUMMARY_TRIGGER_TURNS=12

# Tracing (Langfuse, optional). Start it with:
#   docker compose --profile tracing up -d langfuse-db langfuse
# Console http://localhost:3000 (bootstrapped admin@example.com / langfuse-local-admin).
# Install the app extra: uv pip install -e '.[tracing]'
# Then set TRACING_ENABLED=true and restart the app to record traces.
TRACING_ENABLED=false
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
